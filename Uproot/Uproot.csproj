<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: the Windows SDK projection, for Windows.Management.Deployment (Store apps) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Uproot</AssemblyName>
    <Version>1.0.1</Version>
    <Product>Uproot</Product>
    <AssemblyTitle>Uproot</AssemblyTitle>
    <Description>Uninstalls Windows apps, with what they leave behind, from a list that opens and searches instantly</Description>
    <Company>Protagonist Labs</Company>
    <Authors>Protagonist Labs</Authors>
    <Copyright>Copyright (c) 2026 Protagonist Labs. MIT licence</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="whatsnew.txt" LogicalName="Uproot.whatsnew.txt" />
    <EmbeddedResource Include="WhatsNew\*.jpg" LogicalName="Uproot.WhatsNew.%(Filename).jpg" />
  </ItemGroup>

</Project>

<Window x:Class="Uproot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Uproot" Width="1180" Height="760" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{DynamicResource UiFont}" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- a scrollbar thumb never shorter than 36 px: over 500 rows it was a speck (Track takes its minimum from this key) -->
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">72</sys:Double>
        <!-- links in the app's green, underlined only under the pointer: the system blue was unreadable on dark glass -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a row: hover tints it, the chosen one is tinted green with a bar at its left edge (1.0.4) -->
        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,6,2">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,7">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="1.5"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the small rounded labels after a name: Store, In your Shelf, and the orange ones for what's wrong -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PillBackground}" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2"><ContentPresenter /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- refresh and settings: a glyph with no box until the pointer is on it -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- the search field: opaque (sharp text), a quiet outline that turns green while typing -->
        <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
        </Style>
        <!-- the filters for what's wrong: orange, apart from the kinds -->
        <Style x:Key="IssuePill" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
            <Style.Resources>
                <SolidColorBrush x:Key="PillBackground" Color="#24F97316" />
                <SolidColorBrush x:Key="ButtonBorder" Color="#00000000" />
                <SolidColorBrush x:Key="PillBackgroundSelected" Color="#F97316" />
                <SolidColorBrush x:Key="PillBorderSelected" Color="#F97316" />
            </Style.Resources>
            <Setter Property="Foreground" Value="{DynamicResource StatusWarnText}" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,3" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}">
        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- search, filters, settings -->
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"
                        AutomationProperties.Name="Settings" Margin="4,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh the list (F5)" Click="Refresh_Click"
                        AutomationProperties.Name="Refresh" />
                <Grid Width="320" Margin="0,0,16,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" TextChanged="Search_TextChanged" Padding="17,5,5,5" AutomationProperties.Name="Search apps" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search apps" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="35,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel x:Name="Filters" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="all" IsChecked="True" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="desktop" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="store" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource IssuePill}" Tag="drive" Click="Filter_Click" Margin="10,0,6,0"
                                  ToolTip="Installed on a drive that isn't connected now: plug it back in, or delete their entries from the registry" />
                    <ToggleButton Style="{StaticResource IssuePill}" Tag="files" Click="Filter_Click" Margin="0,0,6,0"
                                  ToolTip="Still listed as installed, but their folder or uninstaller has been deleted" />
                    <ToggleButton Style="{StaticResource IssuePill}" Tag="none" Click="Filter_Click" Margin="0,0,6,0"
                                  ToolTip="Entries with no uninstaller at all: they can only be deleted from the registry" />
                </StackPanel>
            </DockPanel>

            <!-- an update is waiting -->
            <Border x:Name="UpdateBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentDim}" CornerRadius="{DynamicResource CardRadius}"
                    Padding="14,8" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Later" Click="UpdateLater_Click" Margin="8,0,0,0" Padding="12,5" />
                    <Button x:Name="UpdateInstall" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Install and restart" Click="UpdateInstall_Click" Padding="12,5" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- the list, on an opaque card so its text gets ClearType -->
                <Border Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Padding="8,6,2,6" RenderOptions.ClearTypeHint="Enabled">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="0,0,8,6" Padding="8,8,10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="CheckAll" Click="CheckAll_Click" ToolTip="Tick every app shown" AutomationProperties.Name="Tick every app shown" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="name" Click="Sort_Click" x:Name="SortName" />
                            <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="version" Click="Sort_Click" x:Name="SortVersion" />
                            <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Tag="installed" Click="Sort_Click" x:Name="SortInstalled" />
                            <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Tag="size" Click="Sort_Click" x:Name="SortSize" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <Grid>
                        <!-- a ListBox takes the system's text colour (black), not the window's: set it, or the names go black on the dark card -->
                        <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource AppRow}" Foreground="{DynamicResource TextPrimary}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AppList_SelectionChanged" KeyDown="AppList_KeyDown"
                                 MouseDoubleClick="AppList_MouseDoubleClick" AutomationProperties.Name="Installed apps">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False"
                                                  AutomationProperties.Name="{Binding Name}" />
                                        <!-- an app without an icon gets a quiet tile, so the names stay in one column -->
                                        <Border x:Name="NoIcon" Grid.Column="1" Width="28" Height="28" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource PillBackground}" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xECAA;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <Border x:Name="StoreTag" Style="{StaticResource Badge}" Visibility="Collapsed">
                                                    <TextBlock Text="Store" Style="{StaticResource BadgeText}" />
                                                </Border>
                                                <Border x:Name="BrokenTag" Style="{StaticResource Badge}" Background="{DynamicResource StatusWarnDim}" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="10.5" Foreground="{DynamicResource StatusWarn}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                        <TextBlock Text="{Binding IssueTag}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource StatusWarnText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="ShelfTag" Style="{StaticResource Badge}" Background="{DynamicResource AccentDim}" Visibility="Collapsed">
                                                    <TextBlock Text="In your Shelf" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding InstalledText}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="NoIcon" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding KindText}" Value="Store"><Setter TargetName="StoreTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter TargetName="BrokenTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsShelfGame}" Value="True"><Setter TargetName="ShelfTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=EmptyText}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="30" Foreground="{DynamicResource TextSecondary}" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
                </Border>

                <!-- the chosen app -->
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="20,18,14,16" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Panel}" RenderOptions.ClearTypeHint="Enabled">
                    <Grid>
                        <StackPanel x:Name="DetailsEmpty" VerticalAlignment="Center" Margin="10,0,16,40">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentDim}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Pick an app" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="See where it lives and what it takes. Tick several to remove them in one go."
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <ScrollViewer x:Name="Details" Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="0,0,10,0">
                                <DockPanel>
                                    <Image x:Name="DIcon" DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,2,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DPublisher" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="DBroken" Visibility="Collapsed" Background="{DynamicResource StatusWarnDim}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Glyph}" DockPanel.Dock="Left" Text="&#xE7BA;" FontSize="15" Foreground="{DynamicResource StatusWarn}" Margin="0,1,10,0" />
                                        <TextBlock x:Name="DBrokenText" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,16,0,2" />

                                <TextBlock Style="{StaticResource Label}" Text="Size" Margin="0,10,0,3" />
                                <TextBlock x:Name="DSize" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Label}" Text="Version" x:Name="DVersionLabel" />
                                <TextBlock x:Name="DVersion" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Label}" Text="Installed" x:Name="DInstalledLabel" />
                                <TextBlock x:Name="DInstalled" />
                                <TextBlock Style="{StaticResource Label}" Text="Location" x:Name="DLocationLabel" />
                                <TextBlock TextWrapping="Wrap" x:Name="DLocationLine">
                                    <Hyperlink x:Name="DLocation" Click="OpenFolder_Click" TextDecorations="{x:Null}"><Run x:Name="DLocationText" /></Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="DSpaceScanLine" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed">
                                    <Hyperlink Click="SpaceScan_Click">See what's inside with SpaceScan</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Label}" Text="Uninstall command" x:Name="DCommandLabel" />
                                <TextBox x:Name="DCommand" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,6"
                                         Background="{DynamicResource Field}" BorderBrush="{DynamicResource Divider}" Foreground="{DynamicResource TextSecondary}"
                                         AutomationProperties.Name="Uninstall command" />

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button x:Name="DUninstall" Style="{StaticResource PrimaryButton}" Content="Uninstall" Click="UninstallOne_Click" MinWidth="110" Margin="0,0,8,0" />
                                    <Button x:Name="DRemoveEntry" Content="Delete from registry" Click="RemoveEntry_Click"
                                            ToolTip="Deletes its Uninstall entry from the registry, so it leaves Windows' list of installed apps too; the entry is saved to a .reg file first" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- totals and the batch -->
            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <Button x:Name="UninstallChecked" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UninstallChecked_Click" IsEnabled="False" MinWidth="110" />
                <Button x:Name="RemoveChecked" DockPanel.Dock="Right" Click="RemoveChecked_Click" Visibility="Collapsed" Margin="0,0,8,0"
                        ToolTip="Deletes the ticked entries whose drive or files are gone from the registry, so they leave Windows' list of installed apps too; each is saved to a .reg file first" />
                <Button x:Name="StopWaiting" DockPanel.Dock="Right" Content="Stop waiting" Click="StopWaiting_Click" Visibility="Collapsed" Margin="0,0,8,0"
                        ToolTip="Go on to the next app without waiting for this uninstaller to finish" />
                <Button x:Name="ClearChecked" DockPanel.Dock="Right" Content="Clear" Click="ClearChecked_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
            </DockPanel>
        </Grid>
    </Border>
</Window>

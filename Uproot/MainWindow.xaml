<Window x:Class="Uproot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uproot" Width="1180" Height="760" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- a row: hover and selection tint the whole row, nothing else moves -->
        <Style x:Key="AppRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,0,6,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2"><ContentPresenter /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,1" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}">
        <Grid Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- search, filters, settings -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"
                        AutomationProperties.Name="Settings" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh the list (F5)" Click="Refresh_Click"
                        AutomationProperties.Name="Refresh" />
                <Grid Width="340" Margin="0,0,14,0">
                    <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="30,7,10,7" AutomationProperties.Name="Search apps" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search apps" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel x:Name="Filters" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="all" IsChecked="True" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="desktop" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="store" Click="Filter_Click" Margin="0,0,6,0" />
                    <ToggleButton Style="{StaticResource PillToggle}" Tag="broken" Click="Filter_Click" Margin="0,0,6,0"
                                  ToolTip="Entries whose uninstaller is gone: they can only be taken off the list" />
                </StackPanel>
            </DockPanel>

            <!-- an update is waiting -->
            <Border x:Name="UpdateBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentDim}" CornerRadius="{DynamicResource CardRadius}"
                    Padding="14,8" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Later" Click="UpdateLater_Click" Margin="8,0,0,0" Padding="12,5" />
                    <Button x:Name="UpdateInstall" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Install and restart" Click="UpdateInstall_Click" Padding="12,5" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- the list -->
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,0,18,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CheckAll" Click="CheckAll_Click" ToolTip="Tick every app shown" AutomationProperties.Name="Tick every app shown" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="name" Click="Sort_Click" x:Name="SortName" />
                        <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="version" Click="Sort_Click" x:Name="SortVersion" />
                        <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Tag="installed" Click="Sort_Click" x:Name="SortInstalled" />
                        <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Tag="size" Click="Sort_Click" x:Name="SortSize" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource AppRow}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="AppList_SelectionChanged" KeyDown="AppList_KeyDown"
                                 MouseDoubleClick="AppList_MouseDoubleClick" AutomationProperties.Name="Installed apps">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid AutomationProperties.Name="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False"
                                                  AutomationProperties.Name="{Binding Name}" />
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="26" Height="26" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <Border x:Name="StoreTag" Style="{StaticResource Tag}" Background="{DynamicResource PillBackground}" Visibility="Collapsed">
                                                    <TextBlock Text="Store" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                                <Border x:Name="BrokenTag" Style="{StaticResource Tag}" BorderBrush="{DynamicResource StatusWarn}" BorderThickness="1" Visibility="Collapsed">
                                                    <TextBlock Text="Uninstaller missing" FontSize="10.5" Foreground="{DynamicResource StatusWarn}" />
                                                </Border>
                                                <Border x:Name="ShelfTag" Style="{StaticResource Tag}" Background="{DynamicResource PillBackground}" Visibility="Collapsed">
                                                    <TextBlock Text="In your Shelf" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Version}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding InstalledText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding KindText}" Value="Store"><Setter TargetName="StoreTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True"><Setter TargetName="BrokenTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsShelfGame}" Value="True"><Setter TargetName="ShelfTag" Property="Visibility" Value="Visible" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    </Grid>
                </DockPanel>

                <!-- the chosen app -->
                <Border Grid.Column="1" Margin="14,0,0,0" Padding="18,16" CornerRadius="{DynamicResource CardRadius}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="DetailsEmpty" Text="Pick an app to see where it lives and what it takes. Tick several to remove them in one go."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        <ScrollViewer x:Name="Details" Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="0,0,6,0">
                                <Image x:Name="DIcon" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,10" />
                                <TextBlock x:Name="DName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DPublisher" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <Border x:Name="DBroken" Visibility="Collapsed" BorderBrush="{DynamicResource StatusWarn}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                                    <TextBlock x:Name="DBrokenText" TextWrapping="Wrap" FontSize="12" />
                                </Border>

                                <TextBlock Style="{StaticResource Label}" Text="Size" />
                                <TextBlock x:Name="DSize" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Label}" Text="Version" x:Name="DVersionLabel" />
                                <TextBlock x:Name="DVersion" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Label}" Text="Installed" x:Name="DInstalledLabel" />
                                <TextBlock x:Name="DInstalled" />
                                <TextBlock Style="{StaticResource Label}" Text="Location" x:Name="DLocationLabel" />
                                <TextBlock TextWrapping="Wrap" x:Name="DLocationLine">
                                    <Hyperlink x:Name="DLocation" Click="OpenFolder_Click" TextDecorations="{x:Null}"><Run x:Name="DLocationText" /></Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="DSpaceScanLine" FontSize="11.5" Margin="0,3,0,0" Visibility="Collapsed">
                                    <Hyperlink Click="SpaceScan_Click">See what's inside with SpaceScan</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Label}" Text="Uninstall command" x:Name="DCommandLabel" />
                                <TextBox x:Name="DCommand" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="6,4"
                                         AutomationProperties.Name="Uninstall command" />

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="DUninstall" Style="{StaticResource PrimaryButton}" Content="Uninstall" Click="UninstallOne_Click" />
                                    <Button x:Name="DRemoveEntry" Content="Remove from list" Click="RemoveEntry_Click" Margin="8,0,0,0"
                                            ToolTip="Takes the entry off the list, with what it left behind; the registry entry is backed up first" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- totals and the batch -->
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <Button x:Name="UninstallChecked" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="UninstallChecked_Click" IsEnabled="False" />
                <Button x:Name="StopWaiting" DockPanel.Dock="Right" Content="Stop waiting" Click="StopWaiting_Click" Visibility="Collapsed" Margin="0,0,8,0"
                        ToolTip="Go on to the next app without waiting for this uninstaller to finish" />
                <Button x:Name="ClearChecked" DockPanel.Dock="Right" Content="Clear" Click="ClearChecked_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
